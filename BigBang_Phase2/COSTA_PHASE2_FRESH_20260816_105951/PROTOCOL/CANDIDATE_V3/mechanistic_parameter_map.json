  "model_equations": {
    "rate_equation": "tau_i * dr_i/dt = -r_i + rmax_i*S(h_i), for i in {E,I,T,R}",
    "adaptation_equation": "tau_a * da/dt = -a + r_E",
    "sigmoid": "S(h)=1/(1+exp(-beta*(h-theta)))",
    "inputs": {
      "h_E": "b_E + w_EE*r_E - w_EI*r_I + w_ET*r_T - g_a*a + eta_E + u_E(t)",
      "h_I": "b_I + w_IE*r_E - w_II*r_I + w_IT*r_T + eta_I + u_I(t)",
      "h_T": "b_T + w_TE*r_E - w_TR*r_R + eta_T + u_T(t)",
      "h_R": "b_R + w_RE*r_E + w_RT*r_T - w_RR*r_R + eta_R + u_R(t)"
    },
    "ou_noise": "eta_i[n+1]=exp(-dt/tau_eta)*eta_i[n]+sigma_i*sqrt(1-exp(-2*dt/tau_eta))*Normal_i[n]",
    "observation_operator": "x(t)=(r_E(t)+0.25*r_T(t))/10; x is a dimensionless model-output unit (m.u.) proxy, not scalp voltage."
  },
