  "canonicalization": {
    "canonicalization_id": "PY_JSON_CANONICAL_ASCII_V1",
    "formula": "json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')",
    "hash_algorithm": "SHA-256",
    "hash_hex_case": "UPPERCASE",
    "float_rule": "No JSON floating-point number is permitted in a production record. Every finite binary64 diagnostic is a lowercase C99 hexadecimal string from Python float.hex; nonfinite values are represented by status enums and nullable fields, never NaN or Infinity tokens.",
    "array_rule": "Arrays preserve the field-specific order stated below; sort_keys affects object keys only.",
    "nonrecursive_envelope_schema_id": "CANONICAL_JSON_SHA256_ENVELOPE_V6",
    "nonrecursive_envelope_fields": [
      {"name":"schema_id","json_type":"string","units":"NONE","nullable":false,"enum":["CANONICAL_JSON_SHA256_ENVELOPE_V6"],"order_rule":"object key; canonical serialization sorts keys"},
      {"name":"algorithm","json_type":"string","units":"NONE","nullable":false,"enum":["SHA-256"],"order_rule":"object key; canonical serialization sorts keys"},
      {"name":"canonicalization_id","json_type":"string","units":"NONE","nullable":false,"enum":["PY_JSON_CANONICAL_ASCII_V1"],"order_rule":"object key; canonical serialization sorts keys"},
      {"name":"excluded_field","json_type":"string","units":"NONE","nullable":false,"enum":["block_record_hash_envelope","condition_record_hash_envelope"],"order_rule":"object key; value must name the enclosing record's sole excluded field"},
      {"name":"payload_byte_length","json_type":"integer","units":"bytes","nullable":false,"enum":"integer >= 2","order_rule":"object key"},
      {"name":"payload_sha256","json_type":"string","units":"NONE","nullable":false,"enum":"64 uppercase hexadecimal characters","order_rule":"object key"}
    ]
  },
