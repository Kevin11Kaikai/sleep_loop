        {"name":"right_event_id","json_type":"string","units":"NONE","nullable":false,"enum":"canonical event ID","order_rule":"copied from candidate"},
        {"name":"left_anchor_sample","json_type":"integer","units":"stored samples from analysis origin","nullable":false,"enum":"0..35999","order_rule":"copied from candidate"},
        {"name":"right_anchor_sample","json_type":"integer","units":"stored samples from analysis origin","nullable":false,"enum":"0..35999","order_rule":"copied from candidate"},
        {"name":"absolute_anchor_difference_samples","json_type":"integer","units":"stored samples","nullable":false,"enum":"0..50 inclusive","order_rule":"copied from candidate"}
      ]
    },
